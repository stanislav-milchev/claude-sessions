#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
REGISTRY_DIR="${CLAUDE_SESSIONS_DIR:-$HOME/.claude/sessions}"
STATE_FILE="${CLAUDE_SESSIONS_STATE:-$HOME/.cache/claude-sessions/seen.json}"
NOTIFIED_FILE="$(dirname "$STATE_FILE")/notified.json"
PROJECTS_DIR="${CLAUDE_SESSIONS_PROJECTS_DIR:-$HOME/.claude/projects}"
ALIVE_CMD="${CLAUDE_SESSIONS_ALIVE_CMD:-kill -0}"
EMPTY_STATE='{"seen":{},"titles":{}}'

die() {
  printf 'claude-sessions: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'USAGE'
usage: claude-sessions <status|list|rows|jump PID|ack PID|title PID [TEXT]|preview PID|snapshot>
USAGE
  exit 1
}

require_bin() {
  command -v "$1" >/dev/null 2>&1 || die "missing required binary: $1"
}

now_ms() {
  printf '%s' "${CLAUDE_SESSIONS_NOW_MS:-$(date +%s000)}"
}

read_state() {
  if [[ ! -f "$STATE_FILE" ]]; then
    printf '%s' "$EMPTY_STATE"
    return
  fi
  jq -ce '(.seen|type)=="object" and (.titles|type)=="object"' "$STATE_FILE" >/dev/null 2>&1 \
    || die "corrupt state file: $STATE_FILE"
  cat "$STATE_FILE"
}

registry_pid() {
  jq -er '.pid // error("no pid")' "$1" 2>/dev/null || die "unreadable registry file or missing pid: $1"
}

live_registry_files() {
  local f pid
  for f in "$REGISTRY_DIR"/*.json; do
    [[ -e "$f" ]] || continue
    pid="$(registry_pid "$f")"
    if $ALIVE_CMD "$pid" 2>/dev/null; then
      printf '%s\n' "$f"
    fi
  done
}

pane_titles_json() {
  tmux list-panes -a -F '#{pane_id}	#{pane_title}' 2>/dev/null \
    | jq -Rs 'split("\n") | map(select(. != "") | split("\t") | {(.[0]): .[1]}) | add // {}'
}

SNAPSHOT_JQ='
def need(f): if .[f] == null then error("missing field " + f + " in " + input_filename) else . end;
[inputs
 | need("cwd") | need("name") | need("nameSource") | need("status") | need("statusUpdatedAt")
 | (.pid|tostring) as $key
 | (.tmux // "") as $tmux
 | (if $tmux == "" then "" else ($tmux | split(".") | last) end) as $pane
 | (($titles[$pane] // "") | sub("^[^A-Za-z0-9]+[[:space:]]*"; "")) as $paneTitle
 | ($state.titles[$key]
    // (if .nameSource != "derived" then .name
        elif $paneTitle != "" then $paneTitle
        else .name end)) as $title
 | (.cwd
    | sub("^" + $home + "/(apps|personal)/"; "")
    | sub("/(\\.claude/worktrees|\\.worktrees)/"; " ⎇ ")) as $repo
 | (.status != "busy") as $ready
 | ($ready and $tmux != "" and (.statusUpdatedAt > ($state.seen[$key] // 0))) as $unseen
 | (if $unseen then 0 elif $tmux == "" then 3 elif $ready then 1 else 2 end) as $group
 | {pid, sessionId, cwd, tmux: $tmux, pane: $pane, name, status, statusUpdatedAt,
    title: $title, repo: $repo, ready: $ready, unseen: $unseen,
    idleFor: ((($now - .statusUpdatedAt) / 1000) | floor), group: $group}
]
| sort_by(.group, .statusUpdatedAt)
| .[] | del(.group)'

snapshot() {
  local files=() f listing
  listing="$(live_registry_files)"
  [[ -n "$listing" ]] || return 0
  while IFS= read -r f; do files+=("$f"); done <<<"$listing"
  jq -nc \
    --argjson state "$(read_state)" \
    --argjson titles "$(pane_titles_json)" \
    --argjson now "$(now_ms)" \
    --arg home "$HOME" \
    "$SNAPSHOT_JQ" "${files[@]}" \
    || die "registry read failed"
}

write_json_atomic() {
  local path="$1" json="$2" dir tmp
  dir="$(dirname "$path")"
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/.tmp.XXXXXX")"
  printf '%s\n' "$json" > "$tmp"
  mv "$tmp" "$path"
}

live_pids_json() {
  snapshot | jq -sc 'map(.pid|tostring)'
}

prune_to_live() {
  jq -c --argjson live "$(live_pids_json)" '
    .seen   |= with_entries(select(.key as $k | $live | index($k)))
  | .titles |= with_entries(select(.key as $k | $live | index($k)))' <<<"$1"
}

session_row() {
  local row
  row="$(snapshot | jq -c --argjson pid "$1" 'select(.pid == $pid)')"
  [[ -n "$row" ]] || die "no live session with pid $1"
  printf '%s' "$row"
}

ack() {
  local pid="$1" ts state
  ts="$(session_row "$pid" | jq '.statusUpdatedAt')"
  state="$(read_state | jq -c --arg k "$pid" --argjson ts "$ts" '.seen[$k] = $ts')"
  write_json_atomic "$STATE_FILE" "$(prune_to_live "$state")"
}

set_title() {
  local pid="$1" text state
  session_row "$pid" >/dev/null
  if [[ $# -ge 2 ]]; then
    text="$2"
  else
    printf 'title for %s: ' "$pid" >&2
    IFS= read -r text || text=""
  fi
  if [[ -z "$text" ]]; then
    state="$(read_state | jq -c --arg k "$pid" 'del(.titles[$k])')"
  else
    state="$(read_state | jq -c --arg k "$pid" --arg t "$text" '.titles[$k] = $t')"
  fi
  write_json_atomic "$STATE_FILE" "$(prune_to_live "$state")"
}

read_notified() {
  if [[ -f "$NOTIFIED_FILE" ]]; then
    jq -ce 'type=="object"' "$NOTIFIED_FILE" >/dev/null 2>&1 || die "corrupt notified file: $NOTIFIED_FILE"
    cat "$NOTIFIED_FILE"
  else
    printf '{}'
  fi
}

auto_ack_visible_panes() {
  local snap="$1" pane pid
  while IFS= read -r pane; do
    [[ -n "$pane" ]] || continue
    while IFS= read -r pid; do
      [[ -n "$pid" ]] || continue
      ack "$pid"
    done < <(jq -r --arg p "$pane" 'select(.pane == $p and .unseen) | .pid' <<<"$snap")
  done < <(tmux list-clients -F '#{pane_id}' 2>/dev/null)
}

applescript_quote() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

ring_bell() {
  local tty
  while IFS= read -r tty; do
    [[ -n "$tty" ]] || continue
    printf '\a' > "$tty" 2>/dev/null || true
  done < <(tmux list-clients -F '#{client_tty}' 2>/dev/null)
}

send_notification() {
  local title="$1" repo="$2"
  osascript -e "display notification \"$(applescript_quote "$title")\" with title \"$(applescript_quote "$repo") ready\"" \
    >/dev/null 2>&1 || printf 'claude-sessions: osascript failed for notification\n' >&2
}

notify_new_ready() {
  local snap="$1" notified row pid ts title repo rang=0
  notified="$(read_notified)"
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    pid="$(jq -r '.pid' <<<"$row")"
    ts="$(jq -r '.statusUpdatedAt' <<<"$row")"
    [[ "$(jq -r --arg k "$pid" '.[$k] // 0' <<<"$notified")" == "$ts" ]] && continue
    title="$(jq -r '.title' <<<"$row")"
    repo="$(jq -r '.repo' <<<"$row")"
    send_notification "$title" "$repo"
    rang=1
    notified="$(jq -c --arg k "$pid" --argjson ts "$ts" '.[$k] = $ts' <<<"$notified")"
  done < <(jq -c 'select(.unseen)' <<<"$snap")
  if [[ "$rang" -eq 1 ]]; then
    ring_bell
  fi
  notified="$(jq -c --argjson live "$(live_pids_json)" 'with_entries(select(.key as $k | $live | index($k)))' <<<"$notified")"
  write_json_atomic "$NOTIFIED_FILE" "$notified"
}

status_line() {
  local snap="$1" total ready unseen
  total="$(jq -s 'map(select(.tmux != "")) | length' <<<"$snap")"
  ready="$(jq -s 'map(select(.tmux != "" and .ready)) | length' <<<"$snap")"
  unseen="$(jq -s 'map(select(.unseen)) | length' <<<"$snap")"
  if [[ "$unseen" -gt 0 ]]; then
    printf '#[fg=#16161e,bg=#e0af68,bold] ● %d new · %d/%d #[default]' "$unseen" "$ready" "$total"
  elif [[ "$ready" -gt 0 ]]; then
    printf '#[fg=#7aa2f7] ● %d/%d #[default]' "$ready" "$total"
  else
    printf '#[fg=#565f89] ○ %d/%d #[default]' "$ready" "$total"
  fi
}

status() {
  local snap
  snap="$(snapshot)"
  auto_ack_visible_panes "$snap"
  snap="$(snapshot)"
  notify_new_ready "$snap"
  status_line "$snap"
}

jump() {
  local pid="$1" target session rest window pane
  target="$(session_row "$pid" | jq -r '.tmux')"
  [[ -n "$target" ]] || die "pid $pid has no tmux pane"
  session="${target%%:*}"
  rest="${target#*:}"
  window="${rest%%.*}"
  pane="${rest#*.}"
  tmux switch-client -t "$session"
  tmux select-window -t "$session:$window"
  tmux select-pane -t "$pane"
  ack "$pid"
}

main() {
  require_bin jq
  require_bin tmux
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    snapshot) snapshot ;;
    status) status ;;
    jump) [[ $# -eq 1 ]] || usage; jump "$1" ;;
    ack)   [[ $# -eq 1 ]] || usage; ack "$1" ;;
    title) [[ $# -ge 1 ]] || usage; set_title "$@" ;;
    *) usage ;;
  esac
}

main "$@"
