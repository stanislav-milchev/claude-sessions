#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
REGISTRY_DIR="${CLAUDE_SESSIONS_DIR:-$HOME/.claude/sessions}"
STATE_FILE="${CLAUDE_SESSIONS_STATE:-$HOME/.cache/claude-sessions/seen.json}"
NOTIFIED_FILE="$(dirname "$STATE_FILE")/notified.json"
PROJECTS_DIR="${CLAUDE_SESSIONS_PROJECTS_DIR:-$HOME/.claude/projects}"
ALIVE_CMD="${CLAUDE_SESSIONS_ALIVE_CMD:-kill -0}"
ERROR_LOG="$(dirname "$STATE_FILE")/errors.log"
EMPTY_STATE='{"seen":{},"titles":{}}'

die() {
  printf 'claude-sessions: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'USAGE'
usage: claude-sessions <status|list|rows|jump PID|close PID|ack PID|title PID [TEXT]|preview PID|snapshot>
USAGE
  exit 1
}

require_bin() {
  command -v "$1" >/dev/null 2>&1 || die "missing required binary: $1"
}

now_ms() {
  printf '%s' "${CLAUDE_SESSIONS_NOW_MS:-$(date +%s000)}"
}

read_state() {
  if [[ ! -f "$STATE_FILE" ]]; then
    printf '%s' "$EMPTY_STATE"
    return
  fi
  jq -ce '(.seen|type)=="object" and (.titles|type)=="object"' "$STATE_FILE" >/dev/null 2>&1 \
    || die "corrupt state file: $STATE_FILE"
  cat "$STATE_FILE"
}

registry_pid() {
  jq -er '.pid // error("no pid")' "$1" 2>/dev/null || die "unreadable registry file or missing pid: $1"
}

process_start_matches() {
  local pid="$1" recorded="$2" actual
  [[ -n "$recorded" ]] || return 0
  actual="$(TZ=UTC ps -p "$pid" -o lstart= 2>/dev/null | sed 's/^ *//; s/ *$//')"
  [[ "$actual" == "$recorded" ]]
}

live_registry_files() {
  local f pid recorded_start
  for f in "$REGISTRY_DIR"/*.json; do
    [[ -e "$f" ]] || continue
    pid="$(registry_pid "$f")"
    $ALIVE_CMD "$pid" 2>/dev/null || continue
    recorded_start="$(jq -r '.procStart // ""' "$f")"
    process_start_matches "$pid" "$recorded_start" || continue
    printf '%s\n' "$f"
  done
}

pane_titles_json() {
  tmux list-panes -a -F '#{pane_id} #{pane_title}' 2>/dev/null \
    | jq -Rs 'split("\n") | map(select(. != "") | split(" ") | {(.[0]): (.[1:] | join(" "))}) | add // {}'
}

SNAPSHOT_JQ='
def need(f): if .[f] == null then error("missing field " + f + " in " + input_filename) else . end;
[inputs
 | need("cwd") | need("name") | need("status") | need("statusUpdatedAt")
 | (.pid|tostring) as $key
 | (.tmux // "") as $tmux
 | (if $tmux == "" then "" else ($tmux | split(".") | last) end) as $pane
 | (($titles[$pane] // "") | sub("^[^A-Za-z0-9]+[[:space:]]*"; "")) as $paneTitle
 | ($state.titles[$key]
    // (if (.nameSource // "") != "derived" then .name
        elif $paneTitle != "" then $paneTitle
        else .name end)) as $title
 | (.cwd
    | sub("^" + $home + "/(apps|personal)/"; "")
    | sub("/(\\.claude/worktrees|\\.worktrees)/"; " ⎇ ")
    | if startswith("/") then (split("/") | last) else . end) as $repo
 | (.status != "busy") as $ready
 | ($ready and $tmux != "" and (.statusUpdatedAt > ($state.seen[$key] // 0))) as $unseen
 | (if $unseen then 0 elif $tmux == "" then 3 elif $ready then 1 else 2 end) as $group
 | {pid, sessionId, cwd, tmux: $tmux, pane: $pane, name, status, statusUpdatedAt,
    title: $title, repo: $repo, ready: $ready, unseen: $unseen,
    idleFor: ((($now - .statusUpdatedAt) / 1000) | floor), group: $group}
]
| sort_by(.group, .statusUpdatedAt)
| .[] | del(.group)'

snapshot() {
  local files=() f listing
  listing="$(live_registry_files)"
  [[ -n "$listing" ]] || return 0
  while IFS= read -r f; do files+=("$f"); done <<<"$listing"
  jq -nc \
    --argjson state "$(read_state)" \
    --argjson titles "$(pane_titles_json)" \
    --argjson now "$(now_ms)" \
    --arg home "$HOME" \
    "$SNAPSHOT_JQ" "${files[@]}" \
    || die "registry read failed"
}

write_json_atomic() {
  local path="$1" json="$2" dir tmp
  dir="$(dirname "$path")"
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/.tmp.XXXXXX")"
  printf '%s\n' "$json" > "$tmp"
  mv "$tmp" "$path"
}

live_pids_json() {
  snapshot | jq -sc 'map(.pid|tostring)'
}

prune_to_live() {
  jq -c --argjson live "$(live_pids_json)" '
    .seen   |= with_entries(select(.key as $k | $live | index($k)))
  | .titles |= with_entries(select(.key as $k | $live | index($k)))' <<<"$1"
}

session_row() {
  local row
  row="$(snapshot | jq -c --argjson pid "$1" 'select(.pid == $pid)')"
  [[ -n "$row" ]] || die "no live session with pid $1"
  printf '%s' "$row"
}

ack() {
  local pid="$1" ts state
  ts="$(session_row "$pid" | jq '.statusUpdatedAt')"
  state="$(read_state | jq -c --arg k "$pid" --argjson ts "$ts" '.seen[$k] = $ts')"
  write_json_atomic "$STATE_FILE" "$(prune_to_live "$state")"
}

set_title() {
  local pid="$1" text state
  session_row "$pid" >/dev/null
  if [[ $# -ge 2 ]]; then
    text="$2"
  else
    printf 'title for %s: ' "$pid" >&2
    IFS= read -r text || text=""
  fi
  if [[ -z "$text" ]]; then
    state="$(read_state | jq -c --arg k "$pid" 'del(.titles[$k])')"
  else
    state="$(read_state | jq -c --arg k "$pid" --arg t "$text" '.titles[$k] = $t')"
  fi
  write_json_atomic "$STATE_FILE" "$(prune_to_live "$state")"
}

read_notified() {
  if [[ -f "$NOTIFIED_FILE" ]]; then
    jq -ce 'type=="object"' "$NOTIFIED_FILE" >/dev/null 2>&1 || die "corrupt notified file: $NOTIFIED_FILE"
    cat "$NOTIFIED_FILE"
  else
    printf '{}'
  fi
}

auto_ack_visible_panes() {
  local snap="$1" pane pid
  while IFS= read -r pane; do
    [[ -n "$pane" ]] || continue
    while IFS= read -r pid; do
      [[ -n "$pid" ]] || continue
      ack "$pid"
    done < <(jq -r --arg p "$pane" 'select(.pane == $p and .unseen) | .pid' <<<"$snap")
  done < <(tmux list-clients -F '#{pane_id}' 2>/dev/null)
}

applescript_quote() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

ring_bell() {
  local tty
  while IFS= read -r tty; do
    [[ -n "$tty" ]] || continue
    printf '\a' > "$tty" 2>/dev/null || true
  done < <(tmux list-clients -F '#{client_tty}' 2>/dev/null)
}

send_notification() {
  local title="$1" repo="$2"
  osascript -e "display notification \"$(applescript_quote "$title")\" with title \"$(applescript_quote "$repo") ready\"" \
    >/dev/null 2>&1 || printf 'claude-sessions: osascript failed for notification\n' >&2
}

seed_notified_silently() {
  local snap="$1"
  jq -sc 'map(select(.unseen) | {(.pid|tostring): .statusUpdatedAt}) | add // {}' <<<"$snap"
}

notify_new_ready() {
  local snap="$1" notified row pid ts title repo rang=0
  if [[ ! -f "$NOTIFIED_FILE" ]]; then
    write_json_atomic "$NOTIFIED_FILE" "$(seed_notified_silently "$snap")"
    return 0
  fi
  notified="$(read_notified)"
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    pid="$(jq -r '.pid' <<<"$row")"
    ts="$(jq -r '.statusUpdatedAt' <<<"$row")"
    [[ "$(jq -r --arg k "$pid" '.[$k] // 0' <<<"$notified")" == "$ts" ]] && continue
    title="$(jq -r '.title' <<<"$row")"
    repo="$(jq -r '.repo' <<<"$row")"
    send_notification "$title" "$repo"
    rang=1
    notified="$(jq -c --arg k "$pid" --argjson ts "$ts" '.[$k] = $ts' <<<"$notified")"
  done < <(jq -c 'select(.unseen)' <<<"$snap")
  if [[ "$rang" -eq 1 ]]; then
    ring_bell
  fi
  notified="$(jq -c --argjson live "$(live_pids_json)" 'with_entries(select(.key as $k | $live | index($k)))' <<<"$notified")"
  write_json_atomic "$NOTIFIED_FILE" "$notified"
}

status_line() {
  local snap="$1" total ready unseen
  total="$(jq -s 'map(select(.tmux != "")) | length' <<<"$snap")"
  ready="$(jq -s 'map(select(.tmux != "" and .ready)) | length' <<<"$snap")"
  unseen="$(jq -s 'map(select(.unseen)) | length' <<<"$snap")"
  if [[ "$unseen" -gt 0 ]]; then
    printf '#[fg=#16161e,bg=#e0af68,bold] ● %d new · %d/%d #[default]' "$unseen" "$ready" "$total"
  elif [[ "$ready" -gt 0 ]]; then
    printf '#[fg=#7aa2f7] ● %d/%d #[default]' "$ready" "$total"
  else
    printf '#[fg=#565f89] ○ %d/%d #[default]' "$ready" "$total"
  fi
}

status_tick() {
  local snap
  snap="$(snapshot)"
  auto_ack_visible_panes "$snap"
  snap="$(snapshot)"
  notify_new_ready "$snap"
  status_line "$snap"
}

log_errors() {
  local line
  while IFS= read -r line; do
    printf '%s %s\n' "$(date '+%F %T')" "$line"
  done >> "$ERROR_LOG"
}

status() {
  local out
  mkdir -p "$(dirname "$ERROR_LOG")"
  if out="$("$SELF" status-tick 2> >(log_errors))"; then
    printf '%s' "$out"
  else
    printf '#[fg=#f7768e,bold] ! #[default]'
  fi
}

jump() {
  local pid="$1" target session rest window pane
  target="$(session_row "$pid" | jq -r '.tmux')"
  [[ -n "$target" ]] || die "pid $pid has no tmux pane"
  session="${target%%:*}"
  rest="${target#*:}"
  window="${rest%%.*}"
  pane="${rest#*.}"
  tmux switch-client -t "$session"
  tmux select-window -t "$session:$window"
  tmux select-pane -t "$pane"
  ack "$pid"
}

close() {
  local pid="$1" row target pane title answer
  row="$(session_row "$pid")"
  target="$(jq -r '.tmux' <<<"$row")"
  [[ -n "$target" ]] || die "pid $pid has no tmux pane"
  pane="${target##*.}"
  title="$(jq -r '.title' <<<"$row")"
  printf 'kill "%s"? [y/N] ' "$title"
  IFS= read -r answer || answer=""
  [[ "$answer" == [yY] ]] || return 0
  tmux kill-pane -t "$pane"
}

format_age() {
  local s="$1"
  if   [[ "$s" -lt 60 ]];    then printf '%ds' "$s"
  elif [[ "$s" -lt 3600 ]];  then printf '%dm' $((s / 60))
  elif [[ "$s" -lt 86400 ]]; then printf '%dh' $((s / 3600))
  else                            printf '%dd' $((s / 86400))
  fi
}

row_marker() {
  local unseen="$1" ready="$2" tmux="$3"
  if   [[ "$tmux" == "" ]];     then printf '~'
  elif [[ "$unseen" == true ]]; then printf '●'
  elif [[ "$ready" == true ]];  then printf '·'
  else                               printf ' '
  fi
}

rows() {
  local pid title status tmux ready unseen idle repo age marker
  while IFS=$'\x1f' read -r pid title status tmux ready unseen idle repo; do
    age=""
    if [[ "$ready" == true ]]; then
      age="$(format_age "$idle")"
    fi
    marker="$(row_marker "$unseen" "$ready" "$tmux")"
    printf '%s\t%s %s %-5s %4s  %s\n' "$pid" "$marker" "$title" "$status" "$age" "$repo"
  done < <(snapshot | jq -r '
    (.title[:44] | (44 - length) as $pad | if $pad > 0 then . + (" " * $pad) else . end) as $title
    | [.pid, $title, .status, .tmux, .ready, .unseen, .idleFor, .repo] | map(tostring) | join("\u001f")')
}

transcript_path() {
  find "$PROJECTS_DIR" -maxdepth 2 -name "$1.jsonl" -print -quit 2>/dev/null
}

recent_prompts() {
  jq -r '
    select(.type == "user" and (.message.content | type) == "string")
    | select(((.isMeta // false) or (.isSidechain // false)) | not)
    | .message.content | split("\n")[0]
    | select((startswith("<") | not) and (startswith("This session is being continued") | not) and length > 25)' "$1" 2>/dev/null \
    | tail -5 | cut -c1-160 | sed 's/^/  • /'
}

preview() {
  local row cwd sid branch transcript
  row="$(session_row "$1")"
  cwd="$(jq -r '.cwd' <<<"$row")"
  sid="$(jq -r '.sessionId' <<<"$row")"
  branch="$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null || printf '%s' '-')"
  printf 'cwd:    %s\nbranch: %s\n\nrecent prompts:\n' "$cwd" "$branch"
  transcript="$(transcript_path "$sid")"
  if [[ -z "$transcript" ]]; then
    printf '  no transcript\n'
    return 0
  fi
  recent_prompts "$transcript"
}

list() {
  require_bin fzf
  local selected pid
  selected="$(rows | fzf \
      --delimiter='\t' --with-nth=2.. --no-sort --layout=reverse \
      --header='enter: jump   ctrl-x: kill   ctrl-t: set title   ctrl-r: reload   esc: close' \
      --preview "\"$SELF\" preview {1}" --preview-window='right,45%,wrap' \
      --bind "ctrl-r:reload(\"$SELF\" rows)" \
      --bind "ctrl-t:execute(\"$SELF\" title {1} < /dev/tty > /dev/tty)+reload(\"$SELF\" rows)" \
      --bind "ctrl-x:execute(\"$SELF\" close {1} < /dev/tty > /dev/tty)+reload(sleep 0.5; \"$SELF\" rows)" \
    )" || return 0
  pid="$(cut -f1 <<<"$selected")"
  if [[ -n "$pid" ]]; then
    jump "$pid"
  fi
}

main() {
  require_bin jq
  require_bin tmux
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    snapshot) snapshot ;;
    status) status ;;
    status-tick) status_tick ;;
    jump) [[ $# -eq 1 ]] || usage; jump "$1" ;;
    close) [[ $# -eq 1 ]] || usage; close "$1" ;;
    rows)    rows ;;
    preview) [[ $# -eq 1 ]] || usage; preview "$1" ;;
    list)    list ;;
    ack)   [[ $# -eq 1 ]] || usage; ack "$1" ;;
    title) [[ $# -ge 1 ]] || usage; set_title "$@" ;;
    *) usage ;;
  esac
}

main "$@"
